# FastURL Frontend Environment Configuration

# Local Development (standalone Vite dev server at http://localhost:5173 talking to FastAPI at port 8000):
# VITE_API_BASE_URL=http://localhost:8000

# Docker / Production / Nginx Reverse Proxy (Frontend and Backend served on same origin):
# VITE_API_BASE_URL=

VITE_API_BASE_URL=http://localhost:8000
